# Copy to .env (git-ignored) and fill in a partner credential with purpose `catalog` or `both`
# (backoffice: partner → credentials, where the SharedSecret can be revealed).

# Backend origin, e.g. http://localhost:8090 for the catalog repo's mock (npm run mock:api)
ERP_API_URL=
# Empty = the shared /cxml/setup URL; a partner uuid = /cxml/setup/{uuid}
ERP_PARTNER_UUID=
ERP_DOMAIN=NetworkId
ERP_FROM=
# Empty = the From identity
ERP_SENDER=
ERP_SHARED_SECRET=
# Optional, sent as a second From credential
ERP_DUNS=
ERP_TO=
ERP_USER_EMAIL=buyer.user@example.com
ERP_USER_NAME=Test Buyer
# Open the StartPage on another origin, e.g. http://localhost:3001 to run a local catalog against the backend
ERP_START_ORIGIN=
# Empty = PORT (set by Coolify), else 8095
ERP_PORT=8095
# This tool's own public address (BrowserFormPost URL), e.g. https://fake-erp.example.com; empty = COOLIFY_URL (set by Coolify), else http://lvh.me:<port>
ERP_PUBLIC_URL=
# user:password for HTTP Basic auth (all pages but /return and /health); empty = no auth. Set it on any public deployment.
ERP_BASIC_AUTH=
